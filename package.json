{
  "name": "callgraph-extension",
  "displayName": "Call Graph Visualizer",
  "description": "Visualize function call graphs interactively using VS Code LSP Call Hierarchy API.",
  "version": "0.1.6",
  "publisher": "ladun0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "callgraph.viewFileGraph",
        "title": "Generate: Call Graph",
        "category": "Call Graph"
      },
      {
        "command": "callgraph.addFunctionToGraph",
        "title": "Generate: Add to Call Graph",
        "category": "Call Graph"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "callgraph.addFunctionToGraph",
          "when": "resourceLangId == python || resourceLangId == csharp",
          "group": "navigation"
        },
        {
          "command": "callgraph.viewFileGraph",
          "when": "resourceLangId == python || resourceLangId == csharp",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "callgraph.viewFileGraph",
          "when": "resourceLangId == python || resourceLangId == csharp",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "callgraph.viewFileGraph",
          "when": "resourceLangId == python || resourceLangId == csharp",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --watch"
  },
  "devDependencies": {
    "@types/node": "^16.18.34",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.17.19",
    "typescript": "^5.0.4"
  }
}
